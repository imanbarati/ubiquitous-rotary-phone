{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"enagram-platform",
 "main":"@tanstack/react-start/server-entry",
 "compatibility_date":"2026-10-12",
 "compatibility_flags":["nodejs_compat"],
 "observability":{"enabled":true},
 "vars":{"APP_URL":"http://localhost:3000","ENAGRAM_GITHUB_CLIENT_ID":"__ENAGRAM_GITHUB_CLIENT_ID__"},
 "d1_databases":[{"binding":"DB","database_name":"enagram-platform-db","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}